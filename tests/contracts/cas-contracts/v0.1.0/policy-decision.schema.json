{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.coding-autopilot.dev/v0.1/policy-decision.schema.json",
    "title":  "PolicyDecision",
    "type":  "object",
    "allOf":  [
                  {
                      "$ref":  "common.schema.json#/$defs/lifecycleMetadata"
                  },
                  {
                      "type":  "object",
                      "required":  [
                                       "kind",
                                       "decision",
                                       "policyVersion",
                                       "reasons"
                                   ],
                      "properties":  {
                                         "kind":  {
                                                      "const":  "PolicyDecision"
                                                  },
                                         "decision":  {
                                                          "enum":  [
                                                                       "allow",
                                                                       "deny",
                                                                       "require-approval"
                                                                   ]
                                                      },
                                         "policyVersion":  {
                                                               "type":  "string",
                                                               "minLength":  1,
                                                               "maxLength":  64
                                                           },
                                         "reasons":  {
                                                         "type":  "array",
                                                         "minItems":  1,
                                                         "items":  {
                                                                       "type":  "string",
                                                                       "minLength":  1,
                                                                       "maxLength":  1000
                                                                   }
                                                     }
                                     }
                  }
              ],
    "unevaluatedProperties":  false
}
